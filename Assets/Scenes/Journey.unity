  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13c174a7b2e229142adb1d7f4375687e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FloeForward.GameUI
  gameName: FLOE FORWARD
  titleFontSize: 52
  headingFontSize: 30
  titleInstructionsFontSize: 36
  bodyFontSize: 30
  smallFontSize: 22
  buttonFontSize: 26
  popupFontSize: 30
  titleSubtitle: Travel northward through the Arctic Ocean's past, present, and future!
  titleInstructions: 'Lead the polar bear through the ocean. Hold A / D or LEFT / RIGHT to steer him side to side.

    Swim to fish to gain stamina and ice floes to stop stamina drain. Water drains stamina, so don''t swim for too long!

    Blue ice is thin and cracks under pressure, so watch out!'
  startButton: 'START  [ENTER]'
  titleDisclaimer: This is an illustrative experience, not a forecast. After all, polar bears mostly hunt seals, not fish, and they're also not blocky.
  hudScenario: SCENARIO  {0}
  hudStamina: STAMINA  {0} / 100
  hudTime: TIME  {0}s
  statusPreparing: PREPARING
  statusExhausted: EXHAUSTED
  statusArrived: ARRIVED
  statusOnIce: ON ICE
  statusSwimming: SWIMMING
  prepareHeading: PREPARE FOR {0}
  prepareBody: 'Your thin floe is cracking. Get ready!

    Journey begins in {0}...'
  arrivalHeading: Safe Floe Reached!
  choiceTitle: The years have passed...
  choiceSummary: You cleared {0}!
  choicePrompt: Choose a community response for the next scenario. Press 1, 2, or 3.
  choiceOption: '{0}. {1}'
  choiceButton: CHOOSE {0}
  choiceTexts:
  - title: Switch a community's power to wind and solar
    effect: +1 solid floe in each remaining stage.
    meaning: Replacing fossil-fuel electricity with low-emission energy can reduce emissions over time.
  - title: Use paper straws in fast food
    effect: No change to future stages.
    meaning: This sounds meaningful, but consider the energy it takes to manufacture them.
  - title: Use a diesel-powered support boat
    effect: '-1 solid floe in each remaining stage. '
    meaning: Fossil-fuel use can offer convenience, but adds significant greenhouse-gas emissions.
  - title: Walk, cycle, and take public transit more often
    effect: +1 solid floe in the remaining stage.
    meaning: Moving together towards lower-emission travel can heavily reduce transit emissions when done collectively.
  - title: 'Organize tree planting '
    effect: No change to the remaining stage.
    meaning: Trees can cool the planet, but the bulk of CO2 is removed by marine bacteria, and it's difficult to offset climate change with slow-growing trees.
  - title: Add a diesel-powered crossing
    effect: '-1 solid floe in the remaining stage. '
    meaning: Short-term convenience for transportation and commerce can carry a longer-term emissions cost.
  victoryTitle: 'You''ve reached the end of your journey! '
  defeatTitle: Your journey has ended
  victoryMessage: Only our collective action can help protect the Arctic's future.
  defeatMessage: 'This bear did not survive its journey, but our action can protect others like it. '
  endingProgress: 'Year reached: {0}. Stages cleared: {1} / 3.'
  choicesHeading: 'Your Choices:'
  noChoices: No choices made yet
  endingChoice: '{0}: {1} - {2}'
  actionsHeading: What can communities do?
  actionsBody: 'When safe and practical, communities can walk, cycle, or use transit to reduce fossil fuel usage and harmful emissions.

    They can also save energy at home and school, as well as support community efforts for cleaner energy and less waste.'
  factsText: Since 1979, Arctic sea-ice extent has been declining over the long term at a staggering rate. The trend through 2026 is 11.6% per decade, relative to the 1981-2010 average. Countless organisms will lose their homes and ways of life unless we take action.
  playAgainButton: 'PLAY AGAIN  [ENTER]'
